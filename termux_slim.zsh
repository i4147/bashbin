#!/data/data/com.termux/files/usr/bin/zsh
setopt SH_WORD_SPLIT GLOB_SUBST
unsetopt NOMATCH
set -euo pipefail
setopt NULL_GLOB GLOB_DOTS

APPLY=0
for a in "$@"; do
  case "$a" in
    --apply) APPLY=1 ;;
    -h|--help) echo "usage: termux-slim [--apply]  (default: dry run)"; exit 0 ;;
    *) echo "unknown arg: $a" >&2; exit 2 ;;
  esac
done

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
[[ -d "$PREFIX" ]] || { echo "not a Termux prefix: $PREFIX" >&2; exit 1; }

CFG="$PREFIX/etc/dpkg/dpkg.cfg.d/99-termux-slim"

typeset -a STRIP=(
  "$PREFIX/share/man"
  "$PREFIX/share/doc"
  "$PREFIX/share/info"
  "$PREFIX/share/gtk-doc"
  "$PREFIX/share/help"
  "$PREFIX/share/applications"
  "$PREFIX/share/desktop-directories"
  "$PREFIX/share/icons"
  "$PREFIX/share/pixmaps"
  "$PREFIX/share/sounds"
  "$PREFIX/share/themes"
  "$PREFIX/share/mime"
  "$PREFIX/share/locale"
)

typeset -a CACHE_DIRS=(
  "$PREFIX/var/cache/apt/archives"
  "$PREFIX/tmp"
  "$HOME/.cache"
)

typeset -a KEEP=(
  "$HOME/.cache/pip/wheels"
)

human() {
  awk -v k="$1" 'BEGIN{
    if (k >= 1048576)      printf "%.2f GB", k/1048576;
    else if (k >= 1024)    printf "%.1f MB", k/1024;
    else                   printf "%d KB", k
  }'
}
du_kb() { du -sk -- "$@" 2>/dev/null | awk '{s+=$1} END{print s+0}'; }

is_keep()        { local k; for k in "${KEEP[@]}"; do [[ "$1" == "$k" ]]   && return 0; done; return 1; }
has_keep_below() { local k; for k in "${KEEP[@]}"; do [[ "$k" == "$1"/* ]] && return 0; done; return 1; }

typeset -a DELETABLE=()
collect() {
  local dir="$1" child
  for child in "$dir"/*; do
    if is_keep "$child"; then continue; fi
    if has_keep_below "$child"; then collect "$child"; continue; fi
    DELETABLE+=("$child")
  done
}

for d in "${STRIP[@]}" "${CACHE_DIRS[@]}"; do
  [[ -d "$d" ]] && collect "$d"
done

typeset -a KEPT_PRESENT=()
for k in "${KEEP[@]}"; do [[ -e "$k" ]] && KEPT_PRESENT+=("$k"); done

total_kb=0
(( ${#DELETABLE[@]} )) && total_kb=$(du_kb "${DELETABLE[@]}")

echo "kept (will not be touched):"
if (( ${#KEPT_PRESENT[@]} )); then
  for k in "${KEPT_PRESENT[@]}"; do printf '  %8s  %s\n' "$(human "$(du_kb "$k")")" "$k"; done
else
  echo "  (none present yet)"
fi

echo
echo "delete candidates — ${#DELETABLE[@]} items, $(human "$total_kb"):"
if (( ${#DELETABLE[@]} )); then
  for p in "${DELETABLE[@]}"; do printf '  %8s  %s\n' "$(human "$(du_kb "$p")")" "$p"; done
fi

echo
echo "total reclaimable: $(human "$total_kb")"

if [[ $APPLY -eq 0 ]]; then
  echo "dry run — rerun with --apply to execute"
  exit 0
fi

mkdir -p "$(dirname "$CFG")"
{
  echo "# generated by termux-slim $(date -u +%FT%TZ)"
  for d in "${STRIP[@]}"; do printf 'path-exclude=%s/*\n' "$d"; done
} > "$CFG"
echo "wrote $CFG"

(( ${#DELETABLE[@]} )) && rm -rf -- "${DELETABLE[@]}"

echo "done. reclaimed ~$(human "$total_kb")"
echo "revert: rm $CFG && pkg upgrade --reinstall"
